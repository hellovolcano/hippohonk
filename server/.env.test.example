NODE_ENV=test

# Point at a throwaway local database — never production. Either:
#   a) use any local Postgres server with a dedicated, empty "hippohonk_test"
#      database (createdb hippohonk_test), or
#   b) run `docker-compose up -d` from the repo root and use the connection
#      string it prints (defaults to localhost:5433).
DATABASE_URL=postgres://YOUR_LOCAL_USER@localhost:5432/hippohonk_test

SESSION_SECRET=test-session-secret
PORT=4001

# Optional — not every contributor has their own Spotify dev app
# credentials, and the test suite doesn't require them: every test mocks
# services/spotify.js instead, except a small block in tests/spotify.test.js
# that's automatically skipped when these are left unset.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
